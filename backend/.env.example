# Nebius Token Factory (OpenAI-compatible)
# Docs: https://docs.tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Chat model must support tool/function calling — verify in your Nebius console
NEBIUS_CHAT_MODEL=openai/gpt-oss-120b
# Embedding model — same model must be used for indexing and querying
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=claims-intelligence
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=policy-docs

# Hybrid RAG
RRF_K=60
TOP_K_BM25=8
TOP_K_DENSE=8
TOP_K_RRF=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120
ENABLE_RERANK=false

# Agent bounds
MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=120

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173